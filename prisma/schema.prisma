generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Gig {
  id              String   @id @default(uuid())
  userId          String
  artist          String
  artistMbid      String?
  venue           String
  city            String
  date            String
  rating          Int?
  notes           String?
  externalSource  String?
  externalId      String?
  ticketUrl       String?
  venueLatitude   Float?
  venueLongitude  Float?
  venuePlaceName  String?
  venuePlaceId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, artist, date])
  @@unique([userId, externalSource, externalId])
}

model Artist {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  mbid           String?
  imageUrl       String?
  imageSource    String?
  spotifyId      String?
  imageUpdatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([mbid])
}

model SupportPurchase {
  id             String   @id @default(uuid())
  userId         String?
  platform       String
  environment    String
  transactionKey String
  productId      String
  purchasedAt    DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@unique([platform, environment, transactionKey])
  @@index([userId, environment])
}

model SupportStoreState {
  platform       String
  environment    String
  transactionKey String
  productId      String
  eventAt        DateTime
  revokedAt      DateTime?

  @@id([platform, environment, transactionKey], name: "platform_environment_transactionKey")
}

model AccountDeletion {
  userIdHash  String    @id
  requestedAt DateTime  @default(now())
  completedAt DateTime?
}