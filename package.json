{
  "name": "wegig-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@google-cloud/vision": "^5.3.6",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "4.22.3",
    "google-auth-library": "^11.3.4",
    "jose": "^6.2.2",
    "multer": "2.5.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
